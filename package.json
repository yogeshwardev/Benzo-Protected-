{
  "name": "benzo",
  "version": "0.1.0",
  "private": true,
  "description": "BENZO instructor-led technology learning platform",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @benzo/web --filter @benzo/api dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "format": "prettier --write .",
    "bootstrap:super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "seed:courses": "tsx scripts/seed-initial-courses.ts",
    "prisma:generate": "cross-env DATABASE_URL=postgresql://benzo:benzo_password@localhost:5432/benzo?schema=public prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "cross-env DATABASE_URL=postgresql://benzo:benzo_password@localhost:5432/benzo?schema=public prisma validate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@benzo/config": "workspace:*",
    "cross-env": "^10.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
